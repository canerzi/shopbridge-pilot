# Copy this file to .env and fill in your key. NEVER commit .env.
OPENAI_API_KEY=sk-your-key-here
# Set to the small model you're piloting (or a bigger one to A/B):
OPENAI_MODEL=gpt-5.4-mini
PORT=3000

# Matching aggressiveness (optional):
#   MATCH_STRICTNESS = lenient | balanced | strict   (default balanced)
#   REFUSE_AT_BAND   = 4 or 5                          (default 5; lower = refuses more)
MATCH_STRICTNESS=balanced
REFUSE_AT_BAND=5
# Bridge/clarifier — connects the user's wording to the answer ("Aspirin is an over-the-counter
# medicine, so — ..."); fires on typos, fragments, AND specific-wording gaps: on | off
TYPO_CLARIFIER=on

# --- Qualtrics return integration ---
# Anonymous link of the POST-TASK (continuation) survey participants return to:
QUALTRICS_RETURN_URL=https://sabancimanagement.qualtrics.com/jfe/form/SV_7OjA7M4G45YyGge
# Shared secret for the completion_token HMAC. Set the SAME value on Render and keep a copy
# to re-verify tokens offline during analysis. Leave blank to disable the token.
QUALTRICS_HMAC_SECRET=
